<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!--
    Internal gRPC surface (api-contract.yaml's InventoryAvailabilityService, consumed only by
    kart-cart-service's checkout-time validation call) - Grpc.AspNetCore.Server plus the tooling
    package that compiles Protos/inventory_availability.proto at build time (no protoc CLI needed).
  -->
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.66.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\inventory_availability.proto" GrpcServices="Server" />
  </ItemGroup>

  <!--
    kart-conventions.md Observability section: Kart.Shared.Observability wires Serilog + the
    OpenTelemetry SDK behind one DI call - never reimplemented per service.
    Kart.Shared.Configuration wires the GlobalConfig external-secrets-file bootstrap (see
    appsettings.Local.json.example). OpenTelemetry.Extensions.Hosting is kept as a direct
    reference (rather than relying on it transitively) because Program.cs calls
    ConfigureOpenTelemetryTracerProvider/AlwaysOnSampler directly to force 100%-trace sampling
    (kart-inventory-service is one of the four Order-Saga participants required to sample at
    100% - see Kart.Shared.Observability's README "100%-trace-coverage services" section).
  -->
  <ItemGroup>
    <PackageReference Include="Kart.Shared.Configuration" Version="0.1.0" />
    <PackageReference Include="Kart.Shared.Observability" Version="0.2.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\KartInventoryService.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\KartInventoryService.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    contracts/message-bus-manifest.json is this service's single source of truth for its
    RabbitMQ topology - copied here so RabbitMqOptions.ManifestPath (resolved against
    AppContext.BaseDirectory) finds it at runtime without a "../../contracts" relative
    path that would break once this service is deployed as its own container image.
  -->
  <ItemGroup>
    <Content Include="..\..\contracts\message-bus-manifest.json" Link="message-bus-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
